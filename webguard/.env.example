# ============================================================
# WebGuard Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Flask server
FLASK_DEBUG=false
PORT=5000
HOST=127.0.0.1

# Authentication
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# AI explanation provider
# Optional. If empty, WebGuard uses built-in fallback explanations.
# Get a Gemini API key at https://aistudio.google.com
GEMINI_API_KEY=
# Optional. Gemini model used for explanations (change if Google retires it).
GEMINI_MODEL=gemini-2.5-flash
